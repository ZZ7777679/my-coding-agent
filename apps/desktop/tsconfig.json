{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron", "vite/client"]
  },
  "include": ["src", "../../tests/desktop", "electron.vite.config.ts", "playwright.config.ts"]
}
